# ---------------------------------------------------------------------------
# Celebrio environment variables
# Copy this file to .env.local for local development:   cp .env.example .env.local
# NEVER commit real values. In production, set these in Vercel → Project → Settings → Environment Variables.
# Variables starting with NEXT_PUBLIC_ are visible in the browser; everything else stays on the server.
# ---------------------------------------------------------------------------

# Public URL of the site (no trailing slash). Used for payment return URLs, sitemap and emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_LEGAL_ENTITY_NAME="[Your business name]"

# --- Supabase (Project Settings → API) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The "anon" / publishable key. Safe for the browser: Row Level Security protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# The "service_role" / secret key. SERVER ONLY. Bypasses RLS. Never expose or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Payments -----------------------------------------------------------------
# stripe | razorpay | simulator   (simulator = local development only; refused in production)
PAYMENT_PROVIDER=stripe

# Stripe (Developers → API keys / Webhooks). Use sk_test_ / whsec_ values until launch.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Razorpay (Settings → API Keys / Webhooks). Use rzp_test_ keys until launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Local payment simulator (only with PAYMENT_PROVIDER=simulator). Any random 16+ character string.
SIMULATOR_WEBHOOK_SECRET=

# --- Limits (optional) ----------------------------------------------------------
UPLOAD_MAX_BYTES=8000000
UPLOAD_MAX_PIXELS=40000000
EXPORTS_PER_HOUR=30

# --- Testing / CI only ------------------------------------------------------------
# Serve the built-in starter catalogue when Supabase is not configured (CI builds, demos).
# Leave false in real deployments.
CELEBRIO_DEMO_MODE=false
# Throw-away PostgreSQL server for database integration tests. NEVER a real project database.
DATABASE_URL_TEST=
